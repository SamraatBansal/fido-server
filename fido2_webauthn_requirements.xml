  <!-- TASK 3: Registration Options Endpoint Implementation -->
  <Task id="3">
    <Title>Implement Secure Registration Initiation (/webauthn/attestation/options)</Title>
    <RequestFormat>
      {
        "username": "alice@example.com",
        "displayName": "Alice Cooper", 
        "authenticatorSelection": {
          "authenticatorAttachment": "platform",
          "userVerification": "required",
          "residentKey": "required"
        },
        "attestation": "direct",
        "excludeCredentials": ["existing_cred_id_1", "existing_cred_id_2"]
      }
    </RequestFormat>
    <ResponseFormat>
      {
        "sessionId": "uuid-v4-session-id",
        "publicKey": {
          "challenge": "base64url-challenge",
          "rp": {"id": "example.com", "name": "Example Corp"},
          "user": {"id": "base64url-user-id", "name": "alice@example.com", "displayName": "Alice Cooper"},
          "pubKeyCredParams": [{"type": "public-key", "alg": -7}],
          "timeout": 300000,
          "excludeCredentials": [...],
          "authenticatorSelection": {...},
          "attestation": "direct"
        }
      }
    </ResponseFormat>
    <Steps>
      <Step>Validate input parameters including username format, display name length, and authenticator requirements</Step>
      <Step>Create or retrieve existing user account with proper user ID generation (deterministic UUID from username)</Step>
      <Step>Query existing credentials for exclude list to prevent duplicate registrations</Step>
      <Step>Generate registration challenge using webauthn.start_passkey_registration with security parameters</Step>
      <Step>Store registration state with session tracking, IP binding, and expiration management</Step>
      <Step>Return properly formatted CreationChallengeResponse with session identifier</Step>
    </Steps>
    <Functions>
      <Function signature="fn start_registration(request: RegistrationOptionsRequest, client_ip: IpAddr) -> Result&lt;RegistrationOptionsResponse, WebAuthnError&gt;"/>
      <Function signature="fn get_or_create_user(username: &str, display_name: &str) -> Result&lt;UserAccount, WebAuthnError&gt;"/>
      <Function signature="fn get_user_credentials(user_id: Uuid) -> Result&lt;Vec&lt;CredentialDescriptor&gt;, WebAuthnError&gt;"/>
      <Function signature="fn store_pending_registration(session: PendingRegistration) -> Result&lt;(), StorageError&gt;"/>
    </Functions>
    <WeAuthnTypesUsed>
      <Type>webauthn_rs::CreationChallengeResponse</Type>
      <Type>webauthn_rs::PasskeyRegistration</Type>
      <Type>webauthn_rs::AuthenticatorSelectionCriteria</Type>
      <Type>webauthn_rs::UserVerificationPolicy</Type>
    </WeAuthnTypesUsed>
    <SecurityControls>
      <Control name="Input validation" description="Validate all user inputs against defined constraints"/>
      <Control name="Session management" description="Generate cryptographically secure session IDs"/>
      <Control name="IP binding" description="Associate sessions with client IP for replay detection"/>
      <Control name="Rate limiting" description="Limit registration attempts per IP and user"/>
    </SecurityControls>
  </Task>

  <!-- TASK 4: Registration Result Endpoint Implementation -->
  <Task id="4">
    <Title>Complete Registration Flow (/webauthn/attestation/result)</Title>
    <RequestFormat>
      {
        "sessionId": "uuid-v4-session-id",
        "credential": {
          "id": "base64url-credential-id",
          "rawId": "base64url-credential-id", 
          "type": "public-key",
          "response": {
            "clientDataJSON": "base64url-client-data",
            "attestationObject": "base64url-attestation-object"
          }
        },
        "nickname": "My MacBook TouchID"
      }
    </RequestFormat>
    <ResponseFormat>
      {
        "status": "ok",
        "credentialId": "base64url-credential-id",
        "verified": true,
        "attestationInfo": {
          "fmt": "packed",
          "counter": 0,
          "credentialBackedUp": false,
          "credentialDeviceType": "single_device"
        }
      }
    </ResponseFormat>
    <Steps>
      <Step>Validate session ID and retrieve pending registration state with expiration and IP checks</Step>
      <Step>Parse and validate RegisterPublicKeyCredential from client response</Step>
      <Step>Execute webauthn.finish_passkey_registration with comprehensive validation</Step>
      <Step>Extract and validate attestation information including certificate chains</Step>
      <Step>Store validated passkey with metadata and increment user credential count</Step>
      <Step>Clean up pending registration state and return attestation details</Step>
    </Steps>
    <Functions>
      <Function signature="fn finish_registration(request: RegistrationResultRequest, client_ip: IpAddr) -> Result&lt;RegistrationResultResponse, WebAuthnError&gt;"/>
      <Function signature="fn retrieve_pending_registration(session_id: Uuid, client_ip: IpAddr) -> Result&lt;PendingRegistration, WebAuthnError&gt;"/>
      <Function signature="fn validate_attestation_response(credential: &RegisterPublicKeyCredential) -> Result&lt;(), ValidationError&gt;"/>
      <Function signature="fn store_passkey(user_id: Uuid, passkey: Passkey, nickname: Option&lt;String&gt;) -> Result&lt;StoredPasskey, StorageError&gt;"/>
      <Function signature="fn cleanup_expired_sessions() -> Result&lt;usize, StorageError&gt;"/>
    </Functions>
    <WeAuthnTypesUsed>
      <Type>webauthn_rs::RegisterPublicKeyCredential</Type>
      <Type>webauthn_rs::Passkey</Type>
      <Type>webauthn_rs::AttestationObject</Type>
      <Type>webauthn_rs::AttestationStatement</Type>
    </WeAuthnTypesUsed>
    <ValidationChecks>
      <Check name="Session validity" description="Verify session exists, not expired, and IP matches"/>
      <Check name="Credential uniqueness" description="Ensure credential ID is unique across all users"/>
      <Check name="Attestation verification" description="Validate attestation statement and certificate chain"/>
      <Check name="Client data validation" description="Verify challenge, origin, and type in clientDataJSON"/>
    </ValidationChecks>
  </Task>

