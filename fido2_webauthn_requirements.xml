<AgentTasks>
  <Goal>
    Implement a production-ready FIDO2/WebAuthn Relying Party Server in Rust with full FIDO Alliance specification compliance.
    The server must support complete registration (attestation) and authentication (assertion) flows with secure credential storage,
    user management, and enterprise-grade security features. Use **webauthn-rs 0.5+** for all WebAuthn operations.
    
    Core endpoints required:
      1. `POST /webauthn/attestation/options` — initiate credential registration
      2. `POST /webauthn/attestation/result` — complete credential registration  
      3. `POST /webauthn/assertion/options` — initiate authentication
      4. `POST /webauthn/assertion/result` — complete authentication
      5. `GET /webauthn/credentials/{user_id}` — list user credentials
      6. `DELETE /webauthn/credentials/{credential_id}` — revoke credentials
    
    Implementation must include replay attack prevention, credential binding validation, 
    PostgreSQL persistence, comprehensive error handling, and FIDO2 conformance testing.
    Execute tasks sequentially with validation checkpoints between phases.
  </Goal>

  <TechStack>
    <Language>Rust (edition 2021)</Language>
    <Framework>Axum 0.7+</Framework>
    <Runtime>Tokio 1.0+</Runtime>
    <JSON>serde / serde_json</JSON>
    <WeAuthnLibrary>webauthn-rs 0.5+</WeAuthnLibrary>
    <Database>PostgreSQL 14+ with sqlx</Database>
    <Storage>In-memory (development) + PostgreSQL (production)</Storage>
    <ErrorHandling>thiserror + anyhow</ErrorHandling>
    <Logging>tracing + tracing-subscriber</Logging>
    <Configuration>config + dotenvy</Configuration>
    <Security>tower-http (CORS, rate limiting), rustls (TLS)</Security>
    <Testing>tokio-test, sqlx-test, mockall</Testing>
    <Validation>validator crate for input validation</Validation>
  </TechStack>

  <References>
    <Spec url="https://www.w3.org/TR/webauthn-2/" description="WebAuthn Level 2 Specification"/>
    <Spec url="https://fidoalliance.org/specs/fido-v2.0-id-20180227/fido-client-to-authenticator-protocol-v2.0-id-20180227.html" description="FIDO2 CTAP2 Specification"/>
    <Spec url="https://github.com/fido-alliance/conformance-test-tools-resources/blob/main/docs/FIDO2/Server/Conformance-Test-API.md" description="FIDO2 Conformance Test API"/>
    <Crate url="https://docs.rs/webauthn-rs/latest/webauthn_rs/" description="webauthn-rs Documentation"/>
    <Spec url="https://tools.ietf.org/html/rfc8152" description="CBOR Object Signing and Encryption (COSE)"/>
    <Security url="https://owasp.org/www-project-web-security-testing-guide/" description="OWASP WebAuthn Security Guidelines"/>
  </References>

  <!-- TASK 1: Project Foundation & Domain Modeling -->
  <Task id="1">
    <Title>Establish Project Foundation & Core Domain Types</Title>
    <Steps>
      <Step>Initialize Rust workspace with proper dependency management and security-focused Cargo.toml</Step>
      <Step>Define comprehensive domain model for FIDO2/WebAuthn entities with validation</Step>
      <Step>Implement secure in-memory stores with thread-safety and expiration handling</Step>
      <Step>Create centralized error taxonomy covering all WebAuthn failure scenarios</Step>
    </Steps>
    <Structs>
      <Struct name="UserAccount">
        <Field name="user_id" type="Uuid" validation="non-null, unique"/>
        <Field name="username" type="String" validation="length 3-64, alphanumeric + underscores"/>
        <Field name="display_name" type="String" validation="length 1-64, printable chars"/>
        <Field name="email" type="Option&lt;String&gt;" validation="valid email format"/>
        <Field name="passkeys" type="Vec&lt;StoredPasskey&gt;" validation="max 10 credentials per user"/>
        <Field name="created_at" type="DateTime&lt;Utc&gt;"/>
        <Field name="last_used_at" type="Option&lt;DateTime&lt;Utc&gt;&gt;"/>
        <Field name="is_active" type="bool" default="true"/>
      </Struct>
      <Struct name="StoredPasskey">
        <Field name="credential_id" type="String" validation="base64url encoded"/>
        <Field name="passkey" type="Passkey" description="webauthn-rs Passkey struct"/>
        <Field name="nickname" type="Option&lt;String&gt;" validation="length 1-32"/>
        <Field name="created_at" type="DateTime&lt;Utc&gt;"/>
        <Field name="last_used_at" type="Option&lt;DateTime&lt;Utc&gt;&gt;"/>
        <Field name="usage_count" type="u32" default="0"/>
      </Struct>
      <Struct name="PendingRegistration">
        <Field name="session_id" type="Uuid" description="unique session identifier"/>
        <Field name="user_id" type="Uuid"/>
        <Field name="registration_state" type="PasskeyRegistration" description="webauthn-rs state"/>
        <Field name="challenge_response" type="CreationChallengeResponse" description="webauthn-rs response"/>
        <Field name="created_at" type="DateTime&lt;Utc&gt;"/>
        <Field name="expires_at" type="DateTime&lt;Utc&gt;" description="5 minute TTL"/>
        <Field name="client_ip" type="IpAddr" description="for replay attack prevention"/>
      </Struct>
      <Struct name="PendingAuthentication">
        <Field name="session_id" type="Uuid"/>
        <Field name="user_id" type="Uuid"/>
        <Field name="authentication_state" type="PasskeyAuthentication" description="webauthn-rs state"/>
        <Field name="challenge_response" type="RequestChallengeResponse" description="webauthn-rs response"/>
        <Field name="created_at" type="DateTime&lt;Utc&gt;"/>
        <Field name="expires_at" type="DateTime&lt;Utc&gt;" description="5 minute TTL"/>
        <Field name="client_ip" type="IpAddr"/>
      </Struct>
    </Structs>
    <ErrorTypes>
      <Error name="WebAuthnError" variants="UserNotFound, CredentialNotFound, InvalidChallenge, RegistrationFailed, AuthenticationFailed, SessionExpired, ReplayAttack, InvalidInput, DatabaseError, ConfigurationError"/>
    </ErrorTypes>
  </Task>

