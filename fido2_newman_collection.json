          "raw": "{\n    \"id\": \"invalid-credential-id\",\n    \"response\": {\n        \"clientDataJSON\": \"invalid-base64\",\n        \"attestationObject\": \"invalid-base64\"\n    },\n    \"getClientExtensionResults\": {},\n    \"type\": \"public-key\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/attestation/result",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["attestation", "result"]
        }
      }
    },
