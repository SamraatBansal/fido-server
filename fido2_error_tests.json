{
  "info": {
    "name": "FIDO2 Comprehensive Error Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Attestation Options - Valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has expected fields\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('status');",
              "    pm.expect(jsonData).to.have.property('errorMessage');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"johndoe@example.com\", \"displayName\": \"John Doe\"}"
        },
        "url": {"raw": "http://localhost:8080/attestation/options", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["attestation", "options"]}
      }
    },
