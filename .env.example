# FIDO2/WebAuthn Relying Party Server Configuration

# Server Configuration
PORT=3000
HOST=localhost

# WebAuthn Relying Party Configuration
RP_ID=localhost
RP_NAME=FIDO2 WebAuthn Demo
RP_ORIGIN=http://localhost:3000

# Security Configuration
CHALLENGE_TIMEOUT_MINUTES=5
MAX_CREDENTIALS_PER_USER=10

# Database Configuration (for PostgreSQL backend)
# DATABASE_URL=postgresql://username:password@localhost:5432/fido2_webauthn

# Logging Configuration
RUST_LOG=fido2_minimal=info,tower_http=debug,webauthn_rs=info