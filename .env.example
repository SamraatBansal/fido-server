# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_WORKERS=4

# Database Configuration
DATABASE_URL=postgres://localhost/fido_server
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECTION_TIMEOUT=30

# WebAuthn Configuration
WEBAUTHN_RP_NAME=FIDO Server
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8080
WEBAUTHN_TIMEOUT=60000

# Security Configuration
SECURITY_CHALLENGE_EXPIRY_SECONDS=300
SECURITY_MAX_CONCURRENT_REQUESTS=100
SECURITY_RATE_LIMIT_REQUESTS_PER_MINUTE=60
SECURITY_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
RUST_LOG=info