# FIDO Server Configuration
# Copy this file to .env and update with your values

# Database Configuration
FIDO_DATABASE_URL=postgresql://username:password@localhost:5432/fido_server
FIDO_DATABASE_MAX_POOL_SIZE=10
FIDO_DATABASE_TIMEOUT_SECONDS=30
FIDO_DATABASE_IDLE_TIMEOUT_SECONDS=600
FIDO_DATABASE_SSL_MODE=prefer

# Redis Configuration  
FIDO_REDIS_URL=redis://localhost:6379
FIDO_REDIS_MAX_SIZE=10
FIDO_REDIS_TIMEOUT_SECONDS=30
FIDO_REDIS_RECYCLE_TIMEOUT_SECONDS=300

# Server Configuration
FIDO_SERVER_HOST=127.0.0.1
FIDO_SERVER_PORT=8080

# WebAuthn Configuration
FIDO_WEBAUTHN_RP_ID=localhost
FIDO_WEBAUTHN_RP_NAME=FIDO Server
FIDO_WEBAUTHN_ORIGIN=http://localhost:8080

# Runtime Mode (development/production)
RUN_MODE=development