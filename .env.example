# FIDO Server Environment Configuration Example
# Copy this file to .env and configure the values for your environment

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://username:password@localhost:5432/database_name
DATABASE_MAX_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT=5
DATABASE_IDLE_TIMEOUT=600

# Redis Configuration
REDIS_URL=redis://localhost:6379
# For Redis with authentication: redis://:password@localhost:6379
# For Redis with TLS: rediss://localhost:6380
REDIS_MAX_POOL_SIZE=5
REDIS_CONNECTION_TIMEOUT=5
REDIS_COMMAND_TIMEOUT=3
REDIS_SESSION_TTL=300

# WebAuthn Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=FIDO Server
WEBAUTHN_ORIGIN=http://localhost:8080

# Logging Level (trace, debug, info, warn, error)
RUST_LOG=info