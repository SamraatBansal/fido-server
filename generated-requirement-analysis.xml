  <!-- TASK 2: Domain Models & Database Schema -->
  <Task id="2">
    <Title>Define Domain Models & Database Schema</Title>
    <Steps>
      <Step>Design PostgreSQL database schema with proper indexing and constraints.</Step>
      <Step>Define core domain structs with proper validation:</Step>
      <Structs>
        <Struct name="UserAccount">
          <Field name="user_id" type="Uuid" constraints="PRIMARY KEY"/>
          <Field name="username" type="String" constraints="UNIQUE, NOT NULL"/>
          <Field name="display_name" type="String" constraints="NOT NULL"/>
          <Field name="email" type="Option&lt;String&gt;" constraints="UNIQUE"/>
          <Field name="created_at" type="DateTime&lt;Utc&gt;" constraints="NOT NULL"/>
          <Field name="updated_at" type="DateTime&lt;Utc&gt;" constraints="NOT NULL"/>
        </Struct>
        <Struct name="StoredCredential">
          <Field name="credential_id" type="Vec&lt;u8&gt;" constraints="PRIMARY KEY"/>
          <Field name="user_id" type="Uuid" constraints="FOREIGN KEY REFERENCES users(user_id)"/>
          <Field name="public_key" type="Vec&lt;u8&gt;" constraints="NOT NULL"/>
          <Field name="sign_count" type="u32" constraints="NOT NULL DEFAULT 0"/>
          <Field name="transports" type="Option&lt;Vec&lt;String&gt;&gt;"/>
          <Field name="backup_eligible" type="bool" constraints="NOT NULL DEFAULT false"/>
          <Field name="backup_state" type="bool" constraints="NOT NULL DEFAULT false"/>
          <Field name="attestation_object" type="Option&lt;Vec&lt;u8&gt;&gt;"/>
          <Field name="created_at" type="DateTime&lt;Utc&gt;" constraints="NOT NULL"/>
          <Field name="last_used" type="Option&lt;DateTime&lt;Utc&gt;&gt;"/>
        </Struct>
        <Struct name="PendingRegistration">
          <Field name="session_id" type="Uuid" constraints="PRIMARY KEY"/>
          <Field name="user_id" type="Uuid" constraints="FOREIGN KEY REFERENCES users(user_id)"/>
          <Field name="challenge" type="Vec&lt;u8&gt;" constraints="NOT NULL"/>
          <Field name="state" type="Vec&lt;u8&gt;" constraints="NOT NULL, ENCRYPTED"/>
          <Field name="created_at" type="DateTime&lt;Utc&gt;" constraints="NOT NULL"/>
          <Field name="expires_at" type="DateTime&lt;Utc&gt;" constraints="NOT NULL"/>
        </Struct>
        <Struct name="PendingAuthentication">
          <Field name="session_id" type="Uuid" constraints="PRIMARY KEY"/>
          <Field name="user_id" type="Uuid" constraints="FOREIGN KEY REFERENCES users(user_id)"/>
          <Field name="challenge" type="Vec&lt;u8&gt;" constraints="NOT NULL"/>
          <Field name="state" type="Vec&lt;u8&gt;" constraints="NOT NULL, ENCRYPTED"/>
          <Field name="created_at" type="DateTime&lt;Utc&gt;" constraints="NOT NULL"/>
          <Field name="expires_at" type="DateTime&lt;Utc&gt;" constraints="NOT NULL"/>
        </Struct>
      </Structs>
      <Step>Create migration scripts with proper rollback support.</Step>
      <Step>Implement database connection management with health checks.</Step>
    </Steps>
    <SecurityConsiderations>
      <Item>Encrypted storage of sensitive session state data</Item>
      <Item>Proper credential ID indexing for performance</Item>
      <Item>Session expiration and cleanup mechanisms</Item>
      <Item>User data protection and GDPR compliance considerations</Item>
    </SecurityConsiderations>
  </Task>

