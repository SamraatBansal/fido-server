<?xml version="1.0" encoding="UTF-8"?>
<AgentTasks>
  <Goal>
    Implement a production-ready FIDO2/WebAuthn Relying Party Server in Rust that fully complies with FIDO Alliance specifications.
    The server will provide complete passwordless authentication capabilities using the **webauthn-rs** crate (v0.5+) for all WebAuthn-specific operations.
    
    **Core Functionality:**
    - Registration/Attestation Flow: `/webauthn/attestation/options` and `/webauthn/attestation/result`
    - Authentication/Assertion Flow: `/webauthn/assertion/options` and `/webauthn/assertion/result`
    - User management with secure credential binding
    - PostgreSQL persistence with in-memory caching
    - Full FIDO2 compliance testing and validation
    - Production security controls (TLS, replay protection, rate limiting)
    
    **Security Goals:**
    - Prevent credential replay attacks
    - Secure user verification and authentication
    - Protect against timing attacks
    - Implement proper session management
    - FIDO Alliance conformance test suite compatibility
    
    Execute tasks sequentially with confirmation gates between major milestones.
  </Goal>

  <TechStack>
    <Language>Rust 1.70+</Language>
    <Framework>Axum 0.7+ (async web framework)</Framework>
    <Runtime>Tokio 1.0+ (async runtime)</Runtime>
    <JSON>serde 1.0+ / serde_json 1.0+</JSON>
    <WeAuthnLibrary>webauthn-rs 0.5+ (safe public API only)</WeAuthnLibrary>
    <Database>PostgreSQL 15+ with sqlx 0.7+ (async driver)</Database>
    <Caching>In-memory HashMap with RwLock for session management</Caching>
    <ErrorHandling>thiserror 1.0+ (structured error types)</ErrorHandling>
    <Logging>tracing + tracing-subscriber (structured logging)</Logging>
    <Security>tower-http (CORS, TLS), tower-governor (rate limiting)</Security>
    <Configuration>config 0.14+ (environment-based configuration)</Configuration>
    <Testing>tokio-test, sqlx-test, wiremock (integration testing)</Testing>
    <Serialization>base64url, hex (credential encoding)</Serialization>
  </TechStack>

  <References>
    <Spec url="https://www.w3.org/TR/webauthn-2/" title="WebAuthn Level 2 W3C Recommendation"/>
    <Spec url="https://fidoalliance.org/specs/fido-v2.0-ps-20190130/fido-client-to-authenticator-protocol-v2.0-ps-20190130.html" title="FIDO2 CTAP2 Specification"/>
    <Spec url="https://fidoalliance.org/specs/fido-v2.0-ps-20190130/fido-server-requirements-v2.0-ps-20190130.html" title="FIDO Server Requirements"/>
    <Spec url="https://github.com/fido-alliance/conformance-test-tools-resources/blob/main/docs/FIDO2/Server/Conformance-Test-API.md" title="FIDO Alliance Conformance Test API"/>
